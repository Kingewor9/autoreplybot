# --- required ---
BOT_TOKEN=123456:your-bot-token
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net
ADMIN_TELEGRAM_ID=0       # your Telegram numeric user ID; admin panel and new-connection alerts

# --- webhook (production). On Render, RENDER_EXTERNAL_URL is picked up automatically ---
WEBHOOK_BASE_URL=https://your-app.onrender.com
# WEBHOOK_SECRET=optional-stable-secret   (derived from the bot token if omitted)

# --- Paystack (Naira checkout; "I've Paid" verification works without a public URL) ---
PAYSTACK_SECRET_KEY=
PRO_NAIRA_PRICE=7500
GROWTH_NAIRA_PRICE=15000

# --- optional ---
MONGODB_DB=autoreply_bot
STARS_PRICE=250            # monthly price in Telegram Stars
FREE_RULE_LIMIT=2
FREE_REPLY_LIMIT=50        # per calendar month
PAID_RULE_LIMIT=10
COOLDOWN_SECONDS=600       # same contact + same rule won't get the same reply again within this window
EXPIRY_WARNING_DAYS=3
SCHEDULER_INTERVAL=1800    # seconds between subscription checks
MAX_BUTTONS=3
SUPPORT_CONTACT=@your_support_username

# --- plans & follow-ups ---
STARS_PRICE_GROWTH=500     # Growth plan (20 rules, unlimited replies, follow-ups)
GROWTH_RULE_LIMIT=20
FOLLOWUP_MAX_STEPS=3       # follow-up steps per rule
FOLLOWUP_MIN_MINUTES=5     # smallest allowed gap between messages
FOLLOWUP_MAX_TOTAL_MINUTES=1380   # all gaps together; Telegram's window is 24h
NOTIFY_MAX_MINUTES=10080   # longest owner-reminder delay (7 days)
WORKER_POLL_SECONDS=20
ECHO_GUARD_SECONDS=10
